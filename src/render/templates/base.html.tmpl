<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width={{STAGE_W}}, height={{STAGE_H}}">
  <title>{{TITLE}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Anton&family=Bebas+Neue&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <link rel="stylesheet" href="styles.css">
</head>
<body data-theme="{{THEME_KEY}}" data-aspect="{{ASPECT}}" data-character="{{CHARACTER_ID}}"
      style="--stage-w:{{STAGE_W}}px; --stage-h:{{STAGE_H}}px; --scale:{{SCALE}};">
  <div id="stage"
       data-composition-id="news-video"
       data-width="{{STAGE_W}}"
       data-height="{{STAGE_H}}"
       data-start="0"
       data-duration="{{TOTAL_DURATION}}">

    {{SHELL}}

    <audio id="voice"
           class="clip"
           data-start="0"
           data-duration="{{TOTAL_DURATION}}"
           data-track-index="0"
           src="voice.mp3"></audio>

    {{BROLLS}}

    {{SCENES}}

    {{HOST_OVERLAY}}
  </div>
  <script src="animations.js"></script>
</body>
</html>
